<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{page-title}}</title>
    <link rel="stylesheet" href="/assets/css/lib/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/site/main.css">
</head>

<body class="bg-body-secondary">
    <header>
        <nav class="navbar navbar-expand-lg bg-danger border-bottom border-danger" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/dashboard/index">AppCenar</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" aria-current="page" href="/dashboard/index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/clients/index">Clients</a>
                        </li>
                        <li class="nav-item ">
                            <a class="nav-link" href="/deliveries/index">Deliveries</a>
                        </li>
                        <li class="nav-item ">
                            <a class="nav-link" href="/commerces/index">Commerces</a>
                        </li>
                        <li class="nav-item ">
                            <a class="nav-link" href="/configuration/index">Configurations</a>
                        </li>
                        <li class="nav-item ">
                            <a class="nav-link" href="/admins/index">Administrators</a>
                        </li>
                        <li class="nav-item ">
                            <a class="nav-link" href="/commerce-types/index">Commerce Types</a>
                        </li>
                        <li class="nav-item ">
                            <a class="nav-link" href="/user/logout">Log Out</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container mt-3">
        {{#if hasErrors}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <ul>
                {{#each errors}}
                    <li>{{this}}</li>
                {{/each}}
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
        </div>
        {{/if}}

        {{#if hasSuccess}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <ul>
                {{#each success}}
                    <li>{{this}}</li>
                {{/each}}
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
        </div>
        {{/if}}

        {{{body}}}
    </main>
    <footer></footer>

    <script src="/assets/js/lib/bootstrap/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
        integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="/assets/js/lib/bootstrap/bootstrap.bundle.min.js"></script>
    {{{_sections.scripts}}}
</body>

</html>