<div class="row">
    <h1 class="text-center display-4 fw-semibold">{{commerceSelected.name}} products</h1>
</div>

{{#if hasProducts}}

<div class="row d-flex justify-content-center">
    <div class="mb-5 col-12 col-sm-7">
        {{#each groupedProductList}}
        <p class="fw-semibold fs-2">{{this.categoryName}}</p>

        {{#each this.products}}
        <div class="card mb-3 shadow-sm">
            <div class="card-body col-12">
                <div class="row d-flex align-items-center">
                    <div class="col-8 col-sm-9 pe-5">
                        <h2 class="card-title text-center">{{this.name}}</h2>
                        <p class="card-text mb-2">{{this.Description}}</p>
                    </div>
                    <div class="col-4 col-sm-3">
                        <img src="{{this.productPhoto}}" class="img-product img-fluid rounded border border-secondary"
                            alt="{{this.name}}">
                    </div>
                    <div class="row d-flex align-items-start ps-5">
                        <div class="col-3">
                            <h5 class="card-text fs-3 fw-bold">DOP${{this.price}}</h5>
                        </div>
                        {{#if this.isInCart}}
                        {{else}}
                        <form method="post" action="/client-home/add-product" class="col-3">
                            <input type="hidden" value="{{this.productId}}" name="ProductId" />
                            <input type="hidden" value="{{@root.commerceSelected._id}}" name="CommerceId" />
                            <button type="submit" class="btn btn-danger">Add Product</button>
                        </form>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
        {{/each}}
    </div>
    <div class="col-12 col-sm-5 pt-5">
        <div class="card mb-3 shadow-sm">
            <div class="card-header">
                <h5 class="card-text fs-2 fw-bold">My Order</h5>
            </div>

            <div class="card-body col-12">
                <div class="row d-flex justify-content-center">
                    {{#if isCartEmpty}}
                    <div class="col-12 text-center">
                        <i class="bi bi-cart-x display-1 text-secondary"></i>
                        <p class="card-text fs-2 fw-semibold">Your order is empty</p>
                    </div>
                    {{else}}
                    {{#each cartItems}}
                    <div class="list-group ps-2 pb-2">
                        <div class="list-group-item text-center">
                            <div class="row d-flex align-items-center">
                                <div class="col-4 ps-5">
                                    <p class="card-text">{{this.name}}</p>
                                </div>
                                <div class="col-4">
                                    <form method="post" action="/client-home/remove-product">
                                        <input type="hidden" value="{{this.productId}}" name="ProductId" />
                                        <input type="hidden" value="{{@root.commerceSelected._id}}" name="CommerceId" />
                                        <button type="submit" class="btn btn-danger btn-sm">Remove
                                            Product</button>
                                    </form>
                                </div>
                                <div class="col-4">
                                    <p class="card-text">${{this.price}}</h2>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                    <div class="row d-flex justify-content-between">
                        <div class="col-4 ps-5 pb-2">
                            <p class="card-text">Subtotal</p>
                        </div>
                        <div class="col-3">
                            <p class="card-text">${{cartSubtotal}}</p>
                        </div>
                    </div>
                    <div class="row d-flex justify-content-center">
                        <div class="d-grid gap-2">
                            <a href="/client-order/create" class="btn btn-danger"> Continue</a>
                        </div>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>

{{else}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-8 py-5 alert alert-info" role="alert">
        <h2 class="display-5 fw-semibold text-center">Sorry! The commerce have not any categories registered.</h2>
    </div>
</div>
{{/if}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-6 mb-4">
        <div class="d-grid gap-2">
            <a href="/client-home/commerce-list/{{commerceSelected.commerceTypeId}}" class="btn btn-warning"><i
                    class="bi bi-door-open"></i>
                Back to List</a>
        </div>
    </div>
</div>