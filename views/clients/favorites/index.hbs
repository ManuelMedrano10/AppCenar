<div class="row">
    <h1 class="text-center display-4 fw-semibold">My Favorites</h1>
</div>

{{#if hasFavorites}}

<div class="row d-flex justify-content-center">
    <div class="mb-5 col-12 col-sm-10">
        {{#each favoritesList}}
        <div class="card list-group mb-3">
            <div class="col-12">
                <div class="row d-flex d-grid gap-0 column-gap-0">
                    <div class="col-sm-2">
                        <a href="/client-home/commerce-catalogue/{{this.commerceId._id}}"
                            class="list-group-item list-group-item-action">
                            <img src="{{this.commerceId.photo}}" class="img-fluid rounded border border-secondary"
                                alt="{{this.commerceId.name}}">
                        </a>
                    </div>
                    <div class="col-sm-6 pe-5">
                        <h2 class="card-title">{{this.commerceId.name}}</h2>
                        <span>
                            <form method="post" action="/favorites/delete" class="d-inline">
                                <input type="hidden" value="{{this._id}}" name="FavoritedId" />

                                <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                    data-bs-target="#delete-modal-{{this._id}}"><i class="bi bi-trash3"></i> Delete
                                </button>
                                <div class="modal fade" id="delete-modal-{{this._id}}" data-bs-backdrop="static"
                                    data-bs-keyboard="false" tabindex="-1"
                                    aria-labelledby="delete-category-modal-{{this._id}}" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h1 class="modal-title fs-5" id="delete-category-modal-{{this._id}}">
                                                    Delete
                                                    confirmation
                                                </h1>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Are you sure you want to remove this commerce from favorites?</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-danger"
                                                    data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Accept</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

{{else}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-8 py-5 alert alert-info" role="alert">
        <h2 class="display-5 fw-semibold text-center">Sorry! There are not any favorites registered.</h2>
    </div>
</div>
{{/if}}