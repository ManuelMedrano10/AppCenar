<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-light">
                <h5 class="text-center"><i class="bi bi-person-add"></i> Edit Client</h5>
            </div>
            <div class="card-body">
                <form enctype="multipart/form-data" action="/client-profile/edit" method="POST">
                    <div class="mb-3">
                        <label for="name-input" class="form-label">Name: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" value="{{client.name}}" id="name-input" name="Name"
                            required="required" />
                    </div>
                    <div class="mb-3">
                        <label for="lastname-input" class="form-label">Lastname: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" value="{{client.lastname}}" id="lastname-input" name="Lastname"
                            required="required" />
                    </div>
                    <div class="mb-3">
                        <label for="phone-input" class="form-label">Phone: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" value="{{client.phone}}" id="phone-input" name="Phone"
                            required="required" />
                    </div>
                    <div class="mb-3">
                        <label for="photo-input" class="form-label">Photo of client:</label>
                        <input type="file" class="form-control" value="{{client.photo}}" id="photo-input"
                            name="Photo" />
                    </div>
                    <input type="hidden" name="ClientId" value="{{client._id}}" />
                    <div>
                        <button type="submit" class="btn btn-primary float-end"><i class="bi bi-floppy"></i>
                            Save</button>
                        <a href="/client-profile/index" class="btn btn-warning float-end me-2"><i class="bi bi-arrow-left"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>