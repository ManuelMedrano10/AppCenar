<div class="row">
    <h1 class="text-center display-4 fw-semibold">My Orders</h1>
</div>

{{#if hasOrders}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-md-10 mb-4">
        {{#each ordersList}}
        <div class="card mb-3 shadow-sm border-1 list-group">
            <a href="/client-my-orders/detail/{{this._id}}" class="list-group-item-action text-decoration-none text-dark">
                <div class="card-body d-flex align-items-center py-2 px-3">
                    <div class="flex-shrink-0 border rounded p-1 commerce-photo">
                        <img src="{{this.commerceInfo.photo}}" class="img-fluid rounded" alt="{{this.commerceInfo.name}}" >
                    </div>
                    
                    <div class="flex-grow-1 ms-3">
                        <div class="d-flex align-items-center mb-1 fs-6">
                            <span class="fw-bold text-dark text-uppercase">{{this.status}}</span>
                            <span class="text-muted mx-2">&bull;</span><span class="text-muted">{{this.dateTimeOrder}}</span>
                        </div>
                        <h6 class="fw-bold mb-1 text-dark" style="font-size: 1.1rem;">{{this.commerceInfo.name}}</h6>
                        
                        <div class="d-flex align-items-center text-muted" style="font-size: 0.9rem;">
                            <span>RD$ {{this.total}}</span>
                            <span class="mx-2">&bull;</span>
                            <span>{{this.productsQuantity}} productos</span>
                        </div>
                        
                    </div>
                    
                </div>
            </a>
        </div>
        {{/each}}

    </div>
</div>
{{else}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-8 py-5 alert alert-info" role="alert">
        <h2 class="display-5 fw-semibold text-center">You have not any orders registered.</h2>
    </div>
</div>
{{/if}}