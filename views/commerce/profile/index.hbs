<div class="row">
    <h1 class="text-center">My Proffile</h1>
</div>

{{#if hasCommerce}}

<div class="d-flex justify-content-center">
    {{#each isCommerce}}
    <div class="col-12 col-sm-6 mb-4">
        <div class="card mt-2">
            <div class="row g-0">
                <div class="col-md-4">
                    <img src="{{this.photo}}" class="img-fluid rounded-start" alt="{{this.name}}">
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title">{{this.name}}</h5>
                        <p class="card-subtitle mb-1">Email: {{this.email}}</p>
                        <p class="card-text">Phone: {{this.phone}}</p>
                        <p class="card-text">Working Hours: {{this.openingHour}} - {{this.closingHour}}</p>
                        <div class="mt-auto p-2">
                            <a href="/commerce-profile/edit/{{this._id}}" class="btn btn-primary float-end"><i
                                    class="bi bi-pencil"></i> Edit</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>
{{/if}}

{{#section "scripts"}}
<script src=""></script>
{{/section}}