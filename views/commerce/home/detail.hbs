<div class="row d-flex justify-content-center">
    <div class="mb-5 col-12 col-sm-6">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-center">
                    <h2 class="card-title text-center">{{order.commerceId.name}}</h2>
                    <p class="card-subtitle fs-4 fw-semibold">{{order.status}}</p>
                    <p class="card-text">{{order.dateTimeOrder}}</p>
                </div>
                {{#each order.productId}}
                <div class="card-body border-bottom border-secondary d-flex align-items-between py-2 px-3">
                    <div class="flex-shrink-0 p-2 product-photo">
                        <img src="{{this.productPhoto}}" class="img-fluid rounded" alt="{{this.name}}">
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <div class="d-flex justify-content-between py-2 px-4 mb-1 fs-5">
                            <span class="card-title fw-semibold">{{this.name}}</span>
                            <span class="text-muted">RD$ {{this.price}}</span>
                        </div>
                    </div>
                </div>
                {{/each}}
                <div class="row d-flex justify-content-between mb-1 fs-5 fw-bold py-2 px-2">
                    <div class="ps-3 col-4">
                        <p class="list-group-item">Total:</p>
                    </div>
                    <div class="col-3">
                        <p class="list-group-item">RD$ {{order.total}}</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row d-flex justify-content-center pb-5 ps-4 col-12">
            {{#if isOrderPending}}
            <form method="post" action="/commerce-home/assign" class="float-end">
                <input type="hidden" value="{{order._id}}" name="OrderId" />
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-danger float-end" data-bs-toggle="modal"
                        data-bs-target="#assignation-modal">Assign Delivery</button>
                </div>

                {{#if hasDeliveriesAvailable}}
                <div class="modal fade" id="assignation-modal" data-bs-backdrop="static" data-bs-keyboard="false"
                    tabindex="-1" aria-labelledby="assign-delivery-modal" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="assign-delivery-modal">Deliveries availables
                                </h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="card mb-3 shadow-sm">
                                     <div class="card-body col-12">
                                    {{#each deliveriesAvailable}}
                                    <div class="form-check">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item list-group-item-action">
                                                <input type="radio" class="btn-check" name="DeliveryId"
                                                    id="delivery-{{this.name}}" value="{{this._id}}" required="required">
                                                <label class="btn" for="delivery-{{this.name}}"><span
                                                        class="fw-bold">{{this.name}} {{this.lastname}}</label>
                                            </li>
                                        </ul>
                                    </div>
                                    {{/each}}
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Accept</button>
                            </div>
                        </div>
                    </div>
                </div>
                {{/if}}
            </form>
            {{/if}}
        </div>
        <div class="row d-md-flex justify-content-md-end">
            <a href="/commerce-home/home" class="btn btn-warning"><i class="bi bi-door-open"></i>
                Back</a>
        </div>
    </div>
</div>