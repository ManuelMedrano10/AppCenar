<div class="row">
    <h1 class="text-center">Admins list</h1>
</div>

<div class="row mt-2 mb-2">
    <div class="col-12 col-sm-4">
        <a href="/admins/create" class="btn btn-success"><i class="bi bi-bookmark-plus"></i> New Admins</a>
    </div>
</div>

{{#if hasAdmins}}

<div class="row">
    {{#each adminsList}}

    <div class="col-12 col-sm-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Name: {{this.name}} {{this.lastname}} </h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><span class="fw-bold">Username: </span>{{this.username}}</li>
                    <li class="list-group-item"><span class="fw-bold">Cedula: </span>{{this.cedula}}</li>
                    <li class="list-group-item"><span class="fw-bold">Email: </span>{{this.email}}</li>
                </ul>
                <div class="mt-2">
                    <a href="/admins/edit/{{this._id}}" class="btn btn-primary float-end {{#if (eq this._id
                            ../user._id)}}disabled{{/if}}"><i class="bi bi-pencil"></i>
                        Edit</a>
                    <form method="post" action="/admins/activation" class="float-end me-2">
                        <input type="hidden" value="{{this._id}}" name="AdminId" />
                        {{#if this.isActive}}
                        <button type="button" class="btn btn-warning float-end me-2" {{#if (eq this._id
                            ../user._id)}}disabled{{/if}} data-bs-toggle="modal" data-bs-target="#activation-modal-{{this._id}}"><i
                                class="bi bi-toggle-off"></i>
                            Deactivation</button>
                        {{else}}
                        <button type="button" class="btn btn-info float-end me-2" {{#if (eq this._id
                            ../user._id)}}disabled{{/if}} data-bs-toggle="modal" data-bs-target="#activation-modal-{{this._id}}"><i
                                class="bi bi-toggle-on"></i>
                            Activation</button>
                        {{/if}}
                        <div class="modal fade" id="activation-modal-{{this._id}}" data-bs-backdrop="static" data-bs-keyboard="false"
                            tabindex="-1" aria-labelledby="activate-admin-modal-{{this._id}}" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="activate-admin-modal-{{this._id}}">Confirm activation
                                        </h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Are you sure you want to {{#if
                                            this.isActive}}deactivate{{else}}activate{{/if}}
                                            this user?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-danger"
                                            data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Accept</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {{/each}}
</div>

{{else}}

<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-4">
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            You have no admins registered.
        </div>
    </div>
</div>

{{/if}}
{{#section "scripts"}}
<script src=""></script>
{{/section}}